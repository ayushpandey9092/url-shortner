# Copy to .env and adjust. Every setting is optional; these are the defaults.

APP_NAME="URL Shortener"

# Public address of this service. Short links are built from it.
BASE_URL=http://localhost:8000

# SQLite for local use. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://shortener:shortener@localhost:5432/shortener
DATABASE_URL=sqlite:///./data/urls.db

# Short-code generation. Choose your own values ONCE and never change them.
# The multiplier must be odd and not divisible by 31.
CODE_LENGTH=7
ID_SCRAMBLE_MULTIPLIER=2176477521981
ID_SCRAMBLE_OFFSET=1094865271

# 302 = every click is counted. 301 = browsers cache the redirect (less load, fewer stats).
REDIRECT_STATUS_CODE=302

CACHE_MAX_ITEMS=10000
CACHE_TTL_SECONDS=3600

# Link creations allowed per client per minute. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=30
# Set true only when running behind a reverse proxy you control.
TRUST_PROXY_HEADERS=false

MAX_URL_LENGTH=2048
MAX_EXPIRY_DAYS=365
